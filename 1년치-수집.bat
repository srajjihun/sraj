@echo off
chcp 65001 >nul
title 1년치 공고 수집 (백필)
cd /d "%~dp0"

echo.
echo   ══════════════════════════════════════════════
echo     1년치 공고 수집
echo   ══════════════════════════════════════════════
echo.
echo   2025년 1월부터 지금까지의 공고를 월 단위로 받아옵니다.
echo   양이 많아 하루 만에 끝나지 않을 수 있습니다.
echo   중단되면 다음 날 이 파일을 다시 실행하세요. 이어받습니다.
echo.

if "%G2B_SERVICE_KEY%"=="" (
  echo   [오류] 인증키가 등록되지 않았습니다.
  echo          G2B-설치.bat 을 먼저 실행해 주세요.
  echo.
  pause
  exit /b 1
)

node "scripts\g2b\backfill.mjs" %1

echo.
echo   ──────────────────────────────────────────────
echo   수집이 끝났거나 중단되었습니다.
echo   키워드-검증.bat 을 실행하면 지금까지 받은 데이터로
echo   키워드 리포트를 다시 뽑을 수 있습니다.
echo   ──────────────────────────────────────────────
echo.
pause
